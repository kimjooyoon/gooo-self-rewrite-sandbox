program gooo-self-rewrite-candidate v1
candidate changed-terminal-reason
target_phase reflexive.self-rewrite.v1
target_activity LowerSource
rewrite terminal-reason CLOSED "CANDIDATE_REASON_CHANGED"
precondition immutable-input
precondition exact-source-binding
postcondition terminal-evidence-carrying
capability input.read
capability candidate.read
capability caller-temp.write
capability generated.execute
effect none
boundary N+1
accept CLOSED
refute REFUTED
